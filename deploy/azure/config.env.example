# Copy this file to config.env and fill in the values below.
# config.env is gitignored — it will hold real API keys once filled in, never commit it.

# --- Resource naming ---
RG=astra-agents-rg
LOCATION=eastus
DB_SERVER=astra-agents-db
DB_NAME=astra
DB_ADMIN=astraadmin
PLAN=astra-agents-plan
APP_NAME=astra-agents-platform          # must be globally unique across all of Azure; becomes <APP_NAME>.azurewebsites.net

# --- GitHub source for continuous deployment ---
GITHUB_REPO_URL=https://github.com/swarupd227/atlas-agent-platform
GITHUB_BRANCH=main

# --- LLM provider keys (required — the app can't do anything useful without these) ---
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
OPENAI_API_KEY=sk-proj-REPLACE_ME
