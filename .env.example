# Astra Agents — self-host configuration.
# Copy to `.env` (which is git-ignored) and fill in. Values here are the ones
# docker-compose.yml reads; the app itself reads the same names from its
# environment whether you run it via compose, plain Docker, or a PaaS.

# ---- Required ------------------------------------------------------------

# Signing secret for session/JWT auth. Use a long random string, e.g.
#   openssl rand -hex 32
JWT_SECRET=

# Encryption key for the integration credential vault (AES-256-GCM). Any string
# works (it is SHA-256'd to 32 bytes), but use a 64-hex random, e.g.
#   openssl rand -hex 32
# Keep it STABLE: changing it makes previously stored credentials undecryptable.
INTEGRATION_VAULT_KEY=

# Password for the auto-seeded bootstrap admin on first boot. The username is
# fixed to `admin`. Seeded only on an empty database; ignored once users exist.
BOOTSTRAP_ADMIN_PASSWORD=

# ---- Database ------------------------------------------------------------
# By default the app connects to the bundled `db` service using the
# POSTGRES_* values below. To use an external/managed Postgres instead, set
# DATABASE_URL directly and it takes precedence. The database must have the
# pgvector extension available (the app creates it on boot).
POSTGRES_USER=astra
POSTGRES_PASSWORD=astra
POSTGRES_DB=astra
# DATABASE_URL=postgres://user:password@host:5432/dbname

# ---- Server --------------------------------------------------------------
# Port the app listens on (also the published host port in compose).
PORT=5000
# Auth posture: `production` (default) enforces real auth; `demo` bypasses it
# (never use `demo` for a real deployment). Any value other than `demo` is
# treated as `production`.
SECURITY_MODE=production

# ---- Outbound network policy (optional) ----------------------------------
# By default the server refuses to fetch a URL a person or caller supplies if it
# points at a private address (10/8, 172.16/12, 192.168/16, 100.64/10, IPv6 ULA...),
# and always refuses loopback, link-local/cloud-metadata, multicast and reserved
# addresses. If the services Astra must reach sit on a private subnet (for example
# your own VPC), list their ranges here. Comma or space separated entries of
#   <address>[/<prefix>][@<port>]
# e.g. 10.20.0.0/16,10.30.4.7@8443  (the @port limits an entry to one port).
# An entry may only cover private address space; loopback and metadata can never be
# listed. An invalid entry stops the server at boot. Leave empty to allow none.
ASTRA_ALLOWED_PRIVATE_CIDRS=

# How the targets an ADMIN configures (MCP servers, rest-proxy connectors, and the address saved
# on an enterprise connector: Jira, Salesforce, SAP, NetSuite, Databricks, ServiceNow...) are treated.
#   audit    (default) change nothing; log "[outbound-policy] audit: ... would refuse ..." for
#            each target `enforce` would refuse, so you can read what it would break first.
#   enforce  refuse them: private ranges need ASTRA_ALLOWED_PRIVATE_CIDRS above, and loopback is
#            reachable only on this server's own PORT (SECURITY_MODE=demo allows any port).
#   off      neither.
# URLs a person or caller supplies (KB ingestion, spec imports, webhook tests...) are always
# enforced regardless of this setting. A connector address that is malformed (a user name in a
# URL, a path in a NetSuite account id...) is refused when saved in every mode.
ASTRA_OUTBOUND_POLICY=audit

# ---- Platform lockdown (optional) ----------------------------------------
# What this deployment does not allow AT ALL. JSON in ASTRA_LOCKDOWN, or a path to the same JSON in
# ASTRA_LOCKDOWN_FILE (a mounted file or secret); not both. Read once at start-up; nothing in the app
# or its API can change it, and an invalid value stops the server at boot. Unset = nothing restricted.
#   {
#     "marketplace": "off",                      # the connector marketplace and its registry sync
#     "apiKeys": { "agent": "off",               # agent API keys: create, and authenticate with one
#                  "publicApi": "off" },         # the public API (/api/v1) and ASTRA_PUBLIC_API_KEY
#     "llmKeys": "env-only",                     # LLM keys from the environment only; none entered in the app
#     "connectors": { "allow": ["msgraph", "mcp"] },  # ONLY these connector types: registry ids (jira, msgraph...), "mcp", "openapi"; [] = none
#     "nativeTools": { "webSearch": "off",       # Anthropic web search for agents that ask for it
#                      "codeExecution": "off",   # Anthropic code execution, and approving it on a skill
#                      "documents": "off" }      # the platform's own PPTX/PDF/template/inspect tools
#   }
# Whoever controls this deployment's environment or file can still change it.
ASTRA_LOCKDOWN=

# ---- Model / integration keys (optional) ---------------------------------
# Anthropic key powering the agents. AI_INTEGRATIONS_ANTHROPIC_API_KEY is the
# platform-managed alias; either is accepted.
ANTHROPIC_API_KEY=
AI_INTEGRATIONS_ANTHROPIC_API_KEY=
# Optional: OpenAI (alternate provider), GitHub (connector).
OPENAI_API_KEY=
GITHUB_TOKEN=
